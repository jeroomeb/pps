# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (resend.com/api-keys) — the "from" domain must be verified in Resend.
RESEND_API_KEY=
# Completed inspection report emails
EMAIL_FROM="Amenity Op's <reports@amenityops.app>"
# Inspection-assignment notification emails (falls back to EMAIL_FROM if unset)
EMAIL_FROM_ASSIGNMENTS="Amenity Op's <inspections@amenityops.app>"
# CC'd on every report email (e.g. the admin/office inbox)
ADMIN_EMAIL=

# Password-reset emails are sent by Supabase Auth, not this app — configure the
# noreply@amenityops.app sender in Supabase → Authentication → SMTP Settings.

# Canonical site URL (used for email links / password-reset redirects)
NEXT_PUBLIC_SITE_URL=https://portal.amenityops.app

# Business timezone — THE single switch for every schedule calculation and every
# user-visible timestamp (dashboards, checklists, report screen, PDF, emails).
# Must be an IANA zone name, e.g. America/New_York, America/Chicago, Asia/Karachi.
# Changing it is env-var only: set it in Vercel and redeploy — no code change,
# no migration. Defaults to America/New_York if unset.
APP_TIMEZONE=America/New_York
